# ─── Public (bundled into client) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TalentFlow
NEXT_PUBLIC_ENABLE_DEVTOOLS=false

# ─── Server-only (middleware + Server Components) ─────────────────────────────
# Must match JWT_SECRET in apps/api/.env — middleware needs it for token verification
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64-min-32-chars
