{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    // ─── Next.js is compiled by webpack/turbopack, not tsc ──────────────────
    // noEmit: true — tsc is used for type-checking only
    "noEmit": true,

    // ─── Target modern browsers / Node for server components ────────────────
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],

    // ─── JSX: preserve for Next.js to transform with SWC ───────────────────
    "jsx": "preserve",

    // ─── Module: bundler resolution (webpack/turbopack handles resolution) ──
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // ─── Allow JS files in the project (for gradual TS migration) ───────────
    "allowJs": true,

    // ─── Required when moduleResolution=bundler with allowImportingTsExtensions
    "allowImportingTsExtensions": true,

    // ─── Next.js plugin for enhanced IDE support ────────────────────────────
    "plugins": [{ "name": "next" }],

    // ─── Path aliases (populated per-app in apps/web/tsconfig.json) ─────────
    "paths": {}
  },
  "exclude": ["node_modules"]
}
