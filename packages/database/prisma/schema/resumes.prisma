// ─── Resume Intelligence Domain (Phase C — R1) ────────────────────────────────
//
// Phase C builds the foundation for resume ingestion → human review → candidate
// intelligence. R1 covers the storage half only:
//
//   ResumeIntakeBatch         optional grouping for bulk uploads
//   Resume                    logical resume identity, candidate-linked
//   ResumeVersion             immutable file artefact
//   ResumeAccessLog           append-only audit per file access
//   OrganizationExtractionConfig  per-org field allowlist + provider preferences
//
// Parsing, extraction, review, merge are R2-R5 and intentionally absent.
//
// Design notes:
//   • Every table carries organizationId as the first composite-index column.
//   • Resume.candidateId is REQUIRED — upload always creates a draft candidate
//     when the recruiter doesn't pick one explicitly (per architecture review).
//   • ResumeVersion is immutable: no updatedAt, no deletedAt.
//   • ResumeAccessLog is append-only: no updatedAt, no deletedAt.
//   • OrganizationExtractionConfig is UNIQUE per org — created lazily.

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ResumeSource {
  RECRUITER_UPLOAD     // recruiter uploads from candidate page
  VENDOR_SUBMISSION    // resume sent by a vendor (manual recruiter forward)
  API_IMPORT           // bulk import via API
  EMAIL_INTAKE         // future: org-specific intake mailbox

  @@map("resume_source")
}

enum ResumeStatus {
  DRAFT                // resume created, file uploaded; pre-processing
  PROCESSING           // parsing in flight (R2+)
  NEEDS_REVIEW         // extraction complete, HIL queue (R3+)
  ACTIVE               // approved; backing an active candidate
  ARCHIVED             // archived by recruiter; not in active rotation
  REJECTED             // rejected during review; file retained for audit

  @@map("resume_status")
}

enum ResumeIntakeBatchStatus {
  OPEN
  CLOSED

  @@map("resume_intake_batch_status")
}

enum ResumeAccessAction {
  DOWNLOAD             // recruiter downloaded the file
  PREVIEW              // inline preview rendered
  API_FETCH            // programmatic API retrieval
  PARSE_READ           // parser worker read for extraction
  RETENTION_PURGE      // retention job purged the file

  @@map("resume_access_action")
}

enum ResumeParserProvider {
  RULE_BASED
  GEMINI_FLASH
  CLAUDE
  OPENAI_GPT
  AFFINDA
  RCHILLI

  @@map("resume_parser_provider")
}

enum ParsingJobStatus {
  QUEUED        // job created, awaiting worker
  RUNNING       // worker picked it up
  SUCCEEDED     // extraction stored, review required
  FAILED        // unrecoverable error after retries / fallback exhausted
  CANCELLED     // operator cancelled before completion
  SUPERSEDED    // newer version uploaded; this attempt is moot

  @@map("parsing_job_status")
}

enum ReviewTaskStatus {
  PENDING            // queued for a reviewer to claim
  IN_REVIEW          // a reviewer has claimed it (soft-locked)
  APPROVED           // recruiter accepted; resulting Candidate created/updated
  REJECTED           // extraction discarded; resume archived
  REPARSE_REQUESTED  // reviewer asked to reparse; new ReviewTask spawned
  SUPERSEDED         // an upstream change (new version, reparse) invalidated this task

  @@map("review_task_status")
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("review_priority")
}

// ─── ResumeIntakeBatch ────────────────────────────────────────────────────────
// Optional grouping for bulk uploads. A solo resume upload from a candidate
// page doesn't use this — only the bulk-intake flow does. Vendor-blast usage:
// recruiter creates a batch labelled "Apex Talent — 2026-06-10", uploads many
// resumes into it, then closes the batch.

model ResumeIntakeBatch {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid

  label          String                  @db.VarChar(255)
  sourceVendorId String?                 @map("source_vendor_id") @db.Uuid
  status         ResumeIntakeBatchStatus @default(OPEN)

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt      @map("updated_at") @db.Timestamptz
  closedAt       DateTime?                 @map("closed_at")  @db.Timestamptz
  createdBy      String?   @db.Uuid       @map("created_by")

  // Relations
  resumes        Resume[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, sourceVendorId])
  @@map("resume_intake_batches")
}

// ─── Resume ───────────────────────────────────────────────────────────────────
// Logical resume identity. A candidate may have many resumes (variants over
// time, role-specific cuts). currentVersionId is a denormalised pointer to
// the head version for fast list queries.

model Resume {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid

  // Owner — required. Bulk-intake flow creates a draft candidate at upload time.
  candidateId        String        @map("candidate_id") @db.Uuid

  // Optional batch grouping for bulk uploads
  intakeBatchId      String?       @map("intake_batch_id") @db.Uuid

  // Denormalised head version pointer (nullable until v1 is stored)
  currentVersionId   String?       @unique @map("current_version_id") @db.Uuid

  source             ResumeSource  @default(RECRUITER_UPLOAD)
  label              String?       @db.VarChar(255)   // recruiter-supplied tag, e.g. "Senior FE"
  status             ResumeStatus  @default(DRAFT)

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt      @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdBy          String?   @db.Uuid       @map("created_by")
  updatedBy          String?   @db.Uuid       @map("updated_by")
  deletedBy          String?   @db.Uuid       @map("deleted_by")

  // Relations
  intakeBatch        ResumeIntakeBatch? @relation(fields: [intakeBatchId], references: [id], onDelete: SetNull)
  versions           ResumeVersion[]    @relation("ResumeVersions")
  currentVersion     ResumeVersion?     @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, candidateId])
  @@index([organizationId, intakeBatchId])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt])
  @@map("resumes")
}

// ─── ResumeVersion ────────────────────────────────────────────────────────────
// Immutable file artefact. Each upload of a NEW byte sequence creates a new
// version. Re-uploading the same bytes (same sha256) for the same Resume is a
// no-op. Old versions get supersededAt set when superseded.
//
// versionNumber is monotonically increasing per resumeId, generated under a
// row lock by the service (SELECT ... FOR UPDATE on the parent Resume).
//
// storageProvider is recorded on the row so a future migration from one
// backend to another is reversible and auditable.

model ResumeVersion {
  id              String   @id @default(uuid()) @db.Uuid
  resumeId        String   @map("resume_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid

  versionNumber   Int      @map("version_number")
  storageProvider String   @map("storage_provider") @db.VarChar(50)
  storageKey      String   @map("storage_key")     @db.VarChar(2048)
  fileName        String   @map("file_name")       @db.VarChar(512)
  mimeType        String   @map("mime_type")       @db.VarChar(255)
  sizeBytes       BigInt   @map("size_bytes")
  sha256          String   @db.Char(64)            // hex sha256 of the file bytes
  pageCount       Int?     @map("page_count")

  uploadedBy      String   @db.Uuid                @map("uploaded_by")
  uploadedAt      DateTime @default(now())         @map("uploaded_at") @db.Timestamptz
  supersededAt    DateTime?                         @map("superseded_at") @db.Timestamptz

  // Relations
  resume          Resume   @relation("ResumeVersions", fields: [resumeId], references: [id], onDelete: Cascade)
  currentOf       Resume?  @relation("CurrentVersion")
  accessLogs      ResumeAccessLog[]
  parsingJobs     ParsingJob[]      @relation("ParsingJobResumeVersion")
  extractions     ExtractionResult[] @relation("ExtractionResultResumeVersion")

  @@unique([resumeId, versionNumber])
  @@index([organizationId, sha256])
  @@index([organizationId, uploadedAt])
  @@index([organizationId, resumeId])
  @@map("resume_versions")
}

// ─── ResumeAccessLog ──────────────────────────────────────────────────────────
// Append-only audit. Every file access — download, preview, parser fetch,
// retention purge — writes a row. Required for security + compliance.
// No updatedAt, no deletedAt — strictly immutable.

model ResumeAccessLog {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  resumeVersionId String              @map("resume_version_id") @db.Uuid

  actorId         String?             @db.Uuid                @map("actor_id")
  action          ResumeAccessAction
  ipAddress       String?             @db.VarChar(64)         @map("ip_address")
  userAgent       String?             @db.VarChar(512)        @map("user_agent")
  requestId       String?             @db.VarChar(64)         @map("request_id")
  metadata        Json                @default("{}")

  createdAt       DateTime            @default(now())         @map("created_at") @db.Timestamptz

  // Relations
  resumeVersion   ResumeVersion       @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([organizationId, resumeVersionId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@map("resume_access_logs")
}

// ─── ParsingJob ───────────────────────────────────────────────────────────────
// Reified parsing attempt. One row per attempt (retries create new rows, not
// status transitions). The row IS the BullMQ jobId so duplicate enqueues are
// no-ops. errorCode is structured for ops triage; see ParsingErrorCode in
// apps/api/src/modules/resumes/parsers/errors.ts.

model ParsingJob {
  id               String            @id @default(uuid()) @db.Uuid
  resumeVersionId  String            @map("resume_version_id") @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid

  provider         ResumeParserProvider
  providerVersion  String?           @map("provider_version") @db.VarChar(100)
  status           ParsingJobStatus  @default(QUEUED)
  attempt          Int               @default(1)

  startedAt        DateTime?         @map("started_at")  @db.Timestamptz
  finishedAt       DateTime?         @map("finished_at") @db.Timestamptz
  durationMs       Int?              @map("duration_ms")

  // Structured error category: 'transient' | 'permanent' | 'rate_limit' |
  // 'provider_unavailable' | 'budget_exceeded' | 'validation_failed'
  errorCode        String?           @map("error_code") @db.VarChar(64)
  errorMessage     String?           @map("error_message")

  // Cost + token accounting for AI-backed providers
  costUsd          Decimal?          @map("cost_usd")     @db.Decimal(10, 4)
  inputTokens      Int?              @map("input_tokens")
  outputTokens     Int?              @map("output_tokens")

  extractionResultId String?         @unique @map("extraction_result_id") @db.Uuid

  // Relations
  resumeVersion    ResumeVersion     @relation("ParsingJobResumeVersion", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  extractionResult ExtractionResult? @relation(fields: [extractionResultId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt      @map("updated_at") @db.Timestamptz

  @@unique([resumeVersionId, attempt])
  @@index([organizationId, status, startedAt])
  @@index([organizationId, provider])
  @@index([organizationId, createdAt])
  @@map("parsing_jobs")
}

// ─── ExtractionResult ─────────────────────────────────────────────────────────
// Structured parser output. The payload is the CANONICAL post-strip shape
// (see ExtractionPayload type in apps/api/src/modules/resumes/types/extraction-payload.ts).
// rawText is retained for future re-extraction with newer models. schemaVersion
// allows downstream consumers to handle multiple shapes during migration.

model ExtractionResult {
  id                 String   @id @default(uuid()) @db.Uuid
  parsingJobId       String   @unique @map("parsing_job_id") @db.Uuid
  resumeVersionId    String   @map("resume_version_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid

  schemaVersion      Int      @default(1) @map("schema_version")
  payload            Json
  confidence         Json     @default("{}")
  overallConfidence  Decimal  @default(0) @map("overall_confidence") @db.Decimal(4, 3)
  rawText            String?  @map("raw_text") @db.Text
  parserMetadata     Json     @default("{}") @map("parser_metadata")

  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  parsingJob         ParsingJob?       @relation
  resumeVersion      ResumeVersion     @relation("ExtractionResultResumeVersion", fields: [resumeVersionId], references: [id], onDelete: Cascade)
  reviewTask         ReviewTask?       @relation("ExtractionResultReviewTask")

  @@index([resumeVersionId])
  @@index([organizationId, createdAt])
  @@map("extraction_results")
}

// ─── ReviewTask ───────────────────────────────────────────────────────────────
// The HIL queue item. One ReviewTask per ExtractionResult.
//
// Lifecycle (FSM enforced in ReviewTasksService):
//   PENDING ─claim──► IN_REVIEW ─approve──► APPROVED          (terminal)
//                              ─reject ──► REJECTED           (terminal — resume → ARCHIVED)
//                              ─reparse──► REPARSE_REQUESTED  (terminal — new ParsingJob spawns a new ReviewTask)
//                              ─release─► PENDING
//   PENDING ─claim TTL elapse─► PENDING                       (auto-release)
//   any → SUPERSEDED (new resume version uploaded mid-review)
//
// `draftDecision` autosaves on every reviewer edit so partial work survives
// browser closures. `decision` is the final committed payload on terminal
// transitions.

model ReviewTask {
  id                       String           @id @default(uuid()) @db.Uuid
  extractionResultId       String           @unique @map("extraction_result_id") @db.Uuid
  organizationId           String           @map("organization_id") @db.Uuid

  status                   ReviewTaskStatus @default(PENDING)
  priority                 ReviewPriority   @default(NORMAL)

  // Soft lock — set when a reviewer opens the task; auto-expires.
  assigneeId               String?          @map("assignee_id") @db.Uuid
  claimedAt                DateTime?        @map("claimed_at")  @db.Timestamptz
  claimExpiresAt           DateTime?        @map("claim_expires_at") @db.Timestamptz

  // Autosaved partial edits — JSONB shape mirrors `decision` below.
  // draftVersion is an optimistic-concurrency token bumped on every draft save.
  draftDecision            Json?            @map("draft_decision")
  draftVersion             Int              @default(0) @map("draft_version")

  // Final decision (committed on APPROVE / REJECT / REPARSE_REQUESTED).
  decision                 Json?
  decisionNotes            String?          @map("decision_notes") @db.Text
  decidedById              String?          @map("decided_by_id") @db.Uuid
  decidedAt                DateTime?        @map("decided_at") @db.Timestamptz

  // Outcome links — set on APPROVE.
  resultingCandidateId     String?          @map("resulting_candidate_id") @db.Uuid

  // SLA — when the review should be completed by. Drives reminders + queue ordering.
  slaDueAt                 DateTime?        @map("sla_due_at") @db.Timestamptz

  // Reparse chain — points back to the task this one supersedes.
  predecessorReviewTaskId  String?          @map("predecessor_review_task_id") @db.Uuid

  // Relations
  extractionResult         ExtractionResult @relation("ExtractionResultReviewTask", fields: [extractionResultId], references: [id], onDelete: Cascade)
  predecessor              ReviewTask?      @relation("ReviewTaskChain", fields: [predecessorReviewTaskId], references: [id], onDelete: SetNull)
  successors               ReviewTask[]     @relation("ReviewTaskChain")

  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt      @map("updated_at") @db.Timestamptz

  @@index([organizationId, status, slaDueAt])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, priority, slaDueAt])
  @@index([organizationId, createdAt])
  @@index([resultingCandidateId])
  @@map("review_tasks")
}

// ─── OrganizationExtractionConfig ─────────────────────────────────────────────
// Per-org settings governing the future extraction pipeline (R2+).
// Created lazily on first read with platform defaults.
//
// extractFields is a JSON document organising the field allowlist by category.
// customFields is an array of recruiter-defined extra fields the org wants to
// pull from resumes (Phase C requirement: "support custom extraction fields").
// extractionRules carries provider-agnostic knobs (currency hints, units,
// auto-normalize flags). reviewSlaHours / claimTtlMinutes / maxFileBytes /
// monthlyParseBudgetUsd / monthlyParseBudgetCount are operational guardrails.

model OrganizationExtractionConfig {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid

  preferredProvider      ResumeParserProvider  @default(GEMINI_FLASH) @map("preferred_provider")
  fallbackProvider       ResumeParserProvider? @map("fallback_provider")

  // Category → field-name → bool. Disabled fields are stripped by the
  // PayloadStripper stage in R2 before any extraction is persisted.
  extractFields  Json     @default("{}") @map("extract_fields")

  // Recruiter-defined extra fields { id, label, group, type: 'TEXT'|'NUMBER'|'DATE'|'BOOLEAN' }
  customFields   Json     @default("[]") @map("custom_fields")

  // Currency, unit, threshold knobs
  extractionRules Json    @default("{}") @map("extraction_rules")

  // Operational guardrails
  reviewSlaHours          Int      @default(24) @map("review_sla_hours")
  claimTtlMinutes         Int      @default(30) @map("claim_ttl_minutes")
  maxFileBytes            BigInt   @default(10485760) @map("max_file_bytes")  // 10 MB
  monthlyParseBudgetUsd   Decimal? @db.Decimal(10, 2) @map("monthly_parse_budget_usd")
  monthlyParseBudgetCount Int?     @map("monthly_parse_budget_count")

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt      @map("updated_at") @db.Timestamptz
  updatedBy      String?  @db.Uuid        @map("updated_by")

  @@map("organization_extraction_configs")
}
