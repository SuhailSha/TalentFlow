// ─── Enums ────────────────────────────────────────────────────────────────────
//
// All enum types are centralised here so every domain module imports from a
// single place. When adding a new domain, append its enums at the bottom.
//
// Naming conventions
//   Type name  : PascalCase + contextual suffix   e.g.  OrgStatus, UserStatus
//   Value name : SCREAMING_SNAKE_CASE              e.g.  PENDING_VERIFICATION
//   DB type    : @@map → snake_case                e.g.  org_status

// ── Organization ──────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED    // billing/compliance hold — logins blocked, data readable
  CANCELLED    // permanently closed — data retained per retention policy

  @@map("org_status")
}

enum OrgPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE

  @@map("org_plan")
}

// ── User ──────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION  // registered but email not verified
  ACTIVE                // fully operational
  SUSPENDED             // temporarily blocked by admin
  DEACTIVATED           // soft-removed; login impossible, data intact

  @@map("user_status")
}

// ── Candidate ─────────────────────────────────────────────────────────────────

enum CandidateStatus {
  ACTIVE          // in system; not yet ready for placement consideration
  INACTIVE        // in system but not actively pursuing roles
  AVAILABLE       // actively seeking and ready for immediate submission
  PLACED          // successfully placed; tracking relationship
  BLACKLISTED     // internal flag — do not engage

  @@map("candidate_status")
}

enum AvailabilityStatus {
  IMMEDIATELY   // can start within 1–2 weeks
  TWO_WEEKS     // standard notice period
  ONE_MONTH
  THREE_MONTHS
  NOT_LOOKING   // passive — in system for future

  @@map("availability_status")
}

enum CandidateSource {
  MANUAL     // recruiter manually entered
  IMPORT     // bulk CSV/spreadsheet import
  VENDOR     // referred by a vendor (Step 4B.2+)
  JOB_BOARD  // applied via integrated job board (future)
  REFERRAL   // candidate or employee referral (future)

  @@map("candidate_source")
}

// ── Skills ────────────────────────────────────────────────────────────────────

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRAMEWORK_LIBRARY
  DATABASE
  CLOUD_INFRASTRUCTURE
  DEVOPS
  DESIGN
  PROJECT_MANAGEMENT
  SOFT_SKILL
  DOMAIN_EXPERTISE
  OTHER

  @@map("skill_category")
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("proficiency_level")
}

// ── Candidate Notes ───────────────────────────────────────────────────────────

enum NoteType {
  NOTE           // free-form recruiter note
  CALL           // phone/video call log
  EMAIL          // email correspondence log
  MEETING        // in-person or scheduled meeting
  STATUS_CHANGE  // auto-generated when candidate status changes
  SYSTEM         // automated platform event

  @@map("note_type")
}

// ── Vendor ────────────────────────────────────────────────────────────────────

enum VendorStatus {
  PROSPECT    // new — under evaluation, not yet engaged
  ACTIVE      // qualified; current working relationship
  INACTIVE    // relationship dormant; can be reactivated
  BLOCKED     // do not engage — flagged internally; not yet archived
  ARCHIVED    // terminal — soft-deleted; hidden from active listings

  @@map("vendor_status")
}

enum VendorPriority {
  LOW
  NORMAL
  HIGH
  STRATEGIC   // key partner — preferential routing in submissions

  @@map("vendor_priority")
}

enum VendorType {
  STAFFING_AGENCY       // primary source of contractors / perms
  CONSULTING_FIRM       // provides consultants / SOW work
  FREELANCE_PLATFORM    // marketplace (Upwork, Toptal, etc.)
  RECRUITMENT_PARTNER   // co-recruitment / referral partner
  DIRECT_CLIENT         // client that hires directly (client-side platform mode)
  OTHER

  @@map("vendor_type")
}

// ── Job Descriptions ──────────────────────────────────────────────────────────

// Weight applied to a required skill in the matching engine score.
// HIGH required skill outscores LOW required skill even though both are gates.
enum ImportanceLevel {
  LOW
  MEDIUM
  HIGH

  @@map("importance_level")
}

// Lifecycle: DRAFT → OPEN ↔ ON_HOLD → FILLED/CANCELLED → ARCHIVED
// Transitions enforced in JobsService (FSM). Side effects: opened_at/closed_at stamps.
enum JobStatus {
  DRAFT       // being written — not visible to hiring managers yet
  OPEN        // actively sourcing candidates
  ON_HOLD     // temporarily paused (budget freeze, priority shift)
  FILLED      // position filled; submission pipeline marks this
  CANCELLED   // cancelled before filling
  ARCHIVED    // terminal — soft-deleted by admin

  @@map("job_status")
}

// Urgency signal used to sort and triage open roles.
enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT  // SLA-driven — appears at top of dashboards

  @@map("job_priority")
}

// What kind of engagement the position is.
// CONTRACT_TO_HIRE is common in staffing — starts as contract, converts to perm.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONTRACT_TO_HIRE
  FREELANCE
  INTERNSHIP

  @@map("employment_type")
}

// Physical presence requirement for the role.
enum WorkMode {
  ONSITE
  REMOTE
  HYBRID

  @@map("work_mode")
}

// How the salary/rate figure is expressed.
// HOURLY is standard for contract roles; ANNUAL for permanent.
enum SalaryType {
  ANNUAL
  HOURLY
  MONTHLY
  TOTAL_COMPENSATION  // includes bonus/equity (for senior perm roles)

  @@map("salary_type")
}

// ── Interviews ────────────────────────────────────────────────────────────────

// Format of the interview: phone, video, onsite, etc.
enum InterviewType {
  PHONE       // initial phone screen
  VIDEO       // remote video interview (Zoom, Teams, Meet)
  ONSITE      // in-person at client/office location
  PANEL       // multiple interviewers simultaneously
  TECHNICAL   // dedicated technical assessment
  BEHAVIORAL  // competency/culture-fit focused
  CASE_STUDY  // case study / presentation format
  OTHER

  @@map("interview_type")
}

// Lifecycle FSM — see INTERVIEW_FSM in lifecycle.constants.ts
// SCHEDULED → CONFIRMED → IN_PROGRESS → COMPLETED → FEEDBACK_PENDING → PASSED|FAILED
// Any active state → CANCELLED (terminal)
// SCHEDULED|CONFIRMED → RESCHEDULED ↔ CONFIRMED
// NO_SHOW is reachable from SCHEDULED|CONFIRMED|RESCHEDULED|IN_PROGRESS
enum InterviewStatus {
  SCHEDULED        // interview created and time set; awaiting confirmation
  CONFIRMED        // candidate (and interviewer) has confirmed the slot
  RESCHEDULED      // previous slot cancelled; new time being arranged
  IN_PROGRESS      // interview is actively happening right now
  COMPLETED        // interview ended; feedback not yet collected
  FEEDBACK_PENDING // completed but awaiting structured feedback submission
  PASSED           // candidate passed this round (terminal)
  FAILED           // candidate failed this round (terminal)
  NO_SHOW          // candidate (or interviewer) did not appear
  CANCELLED        // interview cancelled before completion (terminal)

  @@map("interview_status")
}

// Interviewer recommendation — drives PASSED/FAILED outcome decision.
enum FeedbackRecommendation {
  STRONG_YES  // exceptional candidate — fast-track
  YES         // hire; meets all criteria
  NEUTRAL     // borderline; needs discussion
  NO          // does not meet criteria
  STRONG_NO   // clear mismatch — do not proceed

  @@map("feedback_recommendation")
}

// Role of a participant in the interview (for panel/multi-interviewer support).
enum InterviewParticipantRole {
  INTERVIEWER   // conducting the interview; can submit feedback
  OBSERVER      // passive observer; can submit notes only
  COORDINATOR   // recruiter/coordinator managing logistics

  @@map("interview_participant_role")
}

// ── Reminders & Notifications ─────────────────────────────────────────────────

// What kind of operational attention this reminder requires.
// CUSTOM = manually created by a recruiter; all others are system-generated.
enum ReminderType {
  UPCOMING_INTERVIEW              // interview scheduled within the next 24–48 h
  INTERVIEW_FEEDBACK_PENDING      // feedback not submitted after interview completed
  OVERDUE_SUBMISSION_FOLLOWUP     // submission has been idle too long
  CANDIDATE_AVAILABILITY_FOLLOWUP // need to re-confirm candidate availability
  RECRUITER_ACTION_REQUIRED       // generic recruiter task / follow-up
  STALLED_WORKFLOW                // pipeline item has not moved in N days
  OVERDUE_INTERVIEW_SCHEDULING    // submission is in SHORTLISTED with no interview
  PENDING_RECRUITER_REVIEW        // waiting for recruiter decision or review
  INTERVIEW_CONFIRMATION_NEEDED   // interview not confirmed by candidate/interviewer
  CUSTOM                          // manually created by a recruiter

  @@map("reminder_type")
}

// Lifecycle FSM:
//   PENDING → ACKNOWLEDGED → SNOOZED → PENDING (loop until resolved)
//   PENDING | ACKNOWLEDGED | SNOOZED → COMPLETED (positive resolution)
//   PENDING | ACKNOWLEDGED → DISMISSED (recruiter chose to ignore)
//   SNOOZED → PENDING (auto-restored when snoozedUntil passes)
//   PENDING | ACKNOWLEDGED → EXPIRED (past due_at with no action — set by job)
enum ReminderStatus {
  PENDING       // active — needs attention
  ACKNOWLEDGED  // seen; not yet acted on
  SNOOZED       // deferred; auto-restores to PENDING at snoozedUntil
  COMPLETED     // action taken; workflow resolved
  DISMISSED     // recruiter chose not to act (with optional reason)
  EXPIRED       // past due date with no action; set by scheduled job

  @@map("reminder_status")
}

enum ReminderPriority {
  CRITICAL  // overdue or blocking — surface immediately
  HIGH      // due today or soon — surface prominently
  MEDIUM    // due this week — normal visibility
  LOW       // informational / nice-to-have

  @@map("reminder_priority")
}

enum ReminderActivityAction {
  CREATED
  VIEWED
  ACKNOWLEDGED
  SNOOZED
  COMPLETED
  DISMISSED
  ESCALATED
  REOPENED
  UPDATED

  @@map("reminder_activity_action")
}

// Delivery channel — IN_APP is the only channel in Phase 1.
// EMAIL and SMS are reserved for future notification delivery phases.
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING    // created, not yet delivered
  DELIVERED  // delivered to channel (e.g. sent to websocket / email queue)
  READ       // recipient confirmed read
  FAILED     // delivery failed (relevant for email/SMS)

  @@map("notification_status")
}

// ── Submissions ───────────────────────────────────────────────────────────────

// Lifecycle FSM — see lifecycle.constants.ts for transition rules.
// DRAFT → SUBMITTED → UNDER_REVIEW → SHORTLISTED → INTERVIEW → OFFERED → PLACED
// Any non-terminal → REJECTED | WITHDRAWN | ON_HOLD
// ON_HOLD → any active state
// PLACED / REJECTED / WITHDRAWN → CLOSED (terminal)
enum SubmissionStatus {
  DRAFT        // being prepared; not yet formally submitted to client
  SUBMITTED    // formally submitted; awaiting client acknowledgment
  UNDER_REVIEW // client is actively reviewing the CV/profile
  SHORTLISTED  // client has shortlisted for an interview
  INTERVIEW    // interview scheduled or in progress
  OFFERED      // offer extended by client
  PLACED       // candidate accepted and engagement started
  REJECTED     // rejected at this stage (can resubmit with new submission)
  WITHDRAWN    // recruiter or candidate withdrew the submission
  ON_HOLD      // temporarily paused (budget freeze, client delay, etc.)
  CLOSED       // terminal — engagement ended or explicitly closed

  @@map("submission_status")
}
