// ─── Job Descriptions Domain ──────────────────────────────────────────────────
//
// Core recruiting entity: a position that the organization is trying to fill.
// Candidates are linked to JDs via the Submission model (Phase 1B Step 4C.2).
//
// Key design decisions:
//
//  Experience range:
//    Stored as integer years (experience_min / experience_max), NOT as a date.
//    JDs describe requirements, not a specific person's history. Integer years
//    are what recruiters write ("3–5 years of React experience") and what
//    the matching engine compares against CandidateSkill.yearsOfExperience
//    and Candidate.careerStartDate-derived experienceYears.
//
//  Requisition ID (req_id):
//    Human-readable identifier scoped to the org (e.g. "REQ-0042").
//    Generated by the service layer on creation (auto-increment per org, padded).
//    Useful for tracking in ATS integrations, emails, and spreadsheets.
//    Stored separately from the UUID PK to keep UUIDs internal.
//
//  Hiring manager denormalization:
//    hiring_manager_name is stored alongside hiring_manager_id so the JD
//    remains readable even if the user is deleted (SetNull on the FK).
//    This mirrors the CandidateNote author denorm pattern.
//
//  Counters:
//    open_positions: how many seats this JD is hiring for (default 1).
//    filled_positions: denormalized count maintained by the Submission pipeline.
//    filled_positions = open_positions triggers auto-transition to FILLED status.
//    Reserved here so analytics can query JDs without joining submissions.
//
//  Soft delete:
//    deletedAt is set when status transitions to ARCHIVED (the terminal state).
//    The service layer drives soft delete via status transition, not direct delete.
//
//  Full-text search:
//    search_vector tsvector GENERATED ALWAYS AS STORED is added via migration
//    (20240107_job_fts). Weights: A=title, B=department, C=requirements, D=description.
//    Not in Prisma schema (Prisma 5 cannot represent GENERATED columns).
//    Repository uses $queryRaw for FTS queries.

// ─── JobDescription ───────────────────────────────────────────────────────────

model JobDescription {
  // ── Identity ──────────────────────────────────────────────────────────────
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")

  // Human-readable requisition number, org-scoped. e.g. "REQ-0042".
  // Generated at creation; immutable thereafter.
  reqId String @db.VarChar(20) @map("req_id")

  // ── Classification ────────────────────────────────────────────────────────
  title          String         @db.VarChar(255)
  department     String?        @db.VarChar(100)
  employmentType EmploymentType @default(FULL_TIME) @map("employment_type")
  workMode       WorkMode       @default(ONSITE)    @map("work_mode")

  // ── Status & Priority ─────────────────────────────────────────────────────
  status          JobStatus   @default(DRAFT)  // see lifecycle FSM in JobsService
  hiringPriority  JobPriority @default(NORMAL) @map("hiring_priority")

  // ── Hiring context ────────────────────────────────────────────────────────
  // FK nullable: hiring manager may not be a platform user (external stakeholder).
  // Name is denormalized so the JD remains readable after user deletion.
  hiringManagerId   String? @db.Uuid       @map("hiring_manager_id")
  hiringManagerName String? @db.VarChar(255) @map("hiring_manager_name")

  // Number of seats this JD is filling. Usually 1; bulk roles may be 5+.
  openPositions   Int @default(1) @map("open_positions")

  // Maintained by the Submission pipeline when submissions reach PLACED status.
  // When filledPositions = openPositions the service auto-transitions to FILLED.
  filledPositions Int @default(0) @map("filled_positions")

  // ── Experience requirement ────────────────────────────────────────────────
  // Integer years so recruiter input ("3-5 years") maps directly.
  // Matching engine compares these against Candidate.careerStartDate-derived years.
  experienceMin Int? @map("experience_min")
  experienceMax Int? @map("experience_max")

  // ── Compensation ──────────────────────────────────────────────────────────
  // Integer whole-currency units (e.g. USD 95000 = 95000, not cents).
  // NULL = not disclosed (common for contract roles that show only hourly rate).
  salaryMin      Int?       @map("salary_min")
  salaryMax      Int?       @map("salary_max")
  salaryCurrency String?    @db.VarChar(3)   @map("salary_currency") // ISO 4217
  salaryType     SalaryType @default(ANNUAL)  @map("salary_type")

  // ── Location ──────────────────────────────────────────────────────────────
  // May differ from org HQ (e.g. org in NYC, role in Austin).
  city          String? @db.VarChar(100)
  stateProvince String? @db.VarChar(100) @map("state_province")
  country       String? @db.VarChar(100)
  timezone      String? @db.VarChar(50)  // "America/Chicago"

  // ── Content ───────────────────────────────────────────────────────────────
  // Separate columns (not one blob) so each section is independently searchable,
  // renderable in the UI, and extractable by the AI parsing layer (Phase 2).
  description  String? @db.Text              // Full JD narrative
  requirements String? @db.Text              // Required qualifications
  niceToHave   String? @db.Text @map("nice_to_have") // Preferred but not required
  benefits     String? @db.Text              // Compensation + perks description

  // ── Timeline ──────────────────────────────────────────────────────────────
  // Recruiter-entered target: when the role should be filled by.
  targetHireDate DateTime? @map("target_hire_date") @db.Date

  // Set by status transitions — not directly editable.
  // openedAt: stamped when first transition → OPEN.
  // closedAt: stamped when → FILLED or → CANCELLED.
  openedAt DateTime? @map("opened_at")
  closedAt DateTime? @map("closed_at")

  // ── Audit ─────────────────────────────────────────────────────────────────
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime?                 @map("deleted_at") // set by ARCHIVED transition
  createdBy String?   @db.Uuid       @map("created_by")
  updatedBy String?   @db.Uuid       @map("updated_by")
  deletedBy String?   @db.Uuid       @map("deleted_by")

  // ── Relations ─────────────────────────────────────────────────────────────
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hiringManager  User?        @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  jobSkills      JobSkill[]
  notes          JobNote[]

  // ── Indexes ───────────────────────────────────────────────────────────────
  // Tenant isolation — always the first filter in every query.
  @@index([organizationId])
  // Most common filter: active JDs by status.
  @@index([organizationId, status])
  // Priority triage: URGENT OPEN roles surface first on dashboards.
  @@index([organizationId, status, hiringPriority])
  // Department browsing: "Show me all Engineering roles".
  @@index([organizationId, department])
  // Work-mode filter: "remote only" and "hybrid" role views.
  @@index([organizationId, workMode])
  // Employment-type filter: contract vs permanent.
  @@index([organizationId, employmentType])
  // Time-urgency sort: roles with nearest target date appear first.
  @@index([organizationId, targetHireDate])
  // Chronological list view (default sort when no other sort specified).
  @@index([organizationId, createdAt])
  // Soft-delete filter: all active queries append AND deleted_at IS NULL.
  @@index([organizationId, deletedAt])
  // Hiring manager dashboard: "all open roles I own".
  @@index([organizationId, hiringManagerId])
  // Unique req_id within org (enforces no duplicate REQ-XXXX numbers).
  @@unique([organizationId, reqId])
  @@map("job_descriptions")
}

// ─── JobSkill ─────────────────────────────────────────────────────────────────
//
// Links a JobDescription to a required/preferred Skill with importance metadata.
// Uses the same global Skill catalog as CandidateSkill — this is intentional.
// The matching engine joins: CandidateSkill.skillId ↔ JobSkill.skillId
// to produce candidate-JD compatibility scores.
//
// is_required distinguishes hard requirements from nice-to-haves:
//   true  — must have (gates candidate consideration)
//   false — preferred (boosts match score but not blocking)
//
// importance_level gives the matching engine a weight even among required skills:
//   A JD may require React (HIGH) and REST APIs (LOW) — both gates, but React
//   matters more for the role match score.

model JobSkill {
  // ── Identity ──────────────────────────────────────────────────────────────
  id               String @id @default(uuid()) @db.Uuid
  jobDescriptionId String @db.Uuid @map("job_description_id")
  skillId          String @db.Uuid @map("skill_id")

  // ── Requirement metadata ──────────────────────────────────────────────────
  isRequired     Boolean         @default(true)        @map("is_required")
  // Matching engine weight: HIGH required skill scores higher than LOW required.
  importanceLevel ImportanceLevel @default(MEDIUM)     @map("importance_level")

  // Minimum years the JD expects for this specific skill (optional precision).
  minimumYears Int? @map("minimum_years")

  // ── Provenance ────────────────────────────────────────────────────────────
  addedBy String?  @db.Uuid @map("added_by")
  addedAt DateTime @default(now()) @map("added_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  // ── Indexes ───────────────────────────────────────────────────────────────
  // A skill can only be listed once per JD.
  @@unique([jobDescriptionId, skillId])
  // Fetch all skills for a JD (primary load pattern).
  @@index([jobDescriptionId])
  // Matching engine: "all JDs that require React" — primary skill-based query.
  @@index([skillId])
  // Matching engine: "all JDs that REQUIRE (not just prefer) React".
  @@index([skillId, isRequired])
  // UI: "required skills for JD X" — separate from nice-to-haves in the form.
  @@index([jobDescriptionId, isRequired])
  @@map("job_skills")
}

// ─── JobNote ──────────────────────────────────────────────────────────────────
//
// Append-only activity log per JobDescription. Mirrors CandidateNote exactly.
//
// Conventions (same as CandidateNote):
//   - No updatedAt (notes are immutable facts, not editable records)
//   - No soft delete (deleting notes corrupts the activity trail)
//   - authorEmail/authorName denormalized to survive user deletion
//   - jobDescriptionId FK cascades on JD delete (if JD is hard-deleted)
//
// NoteType reuses the same enum as CandidateNote (NOTE, CALL, EMAIL, MEETING,
// STATUS_CHANGE, SYSTEM) — recruiter communication patterns are identical
// regardless of the entity being discussed.

model JobNote {
  // ── Identity ──────────────────────────────────────────────────────────────
  id               String @id @default(uuid()) @db.Uuid
  jobDescriptionId String @db.Uuid @map("job_description_id")
  organizationId   String @db.Uuid @map("organization_id")

  // ── Content ───────────────────────────────────────────────────────────────
  content  String   @db.Text
  noteType NoteType @default(NOTE) @map("note_type")

  // ── Author ────────────────────────────────────────────────────────────────
  authorId    String? @db.Uuid        @map("author_id")
  authorEmail String? @db.VarChar(255) @map("author_email")
  authorName  String? @db.VarChar(255) @map("author_name")

  // ── Append-only timestamp ─────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User?          @relation("JobNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // ── Indexes ───────────────────────────────────────────────────────────────
  @@index([jobDescriptionId])
  @@index([organizationId])
  @@index([jobDescriptionId, createdAt])
  @@map("job_notes")
}
