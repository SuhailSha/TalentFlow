// ─── Reminders & Notifications Domain ─────────────────────────────────────────
//
// Models:
//   Reminder          — operational action item with due dates, priority, FSM lifecycle
//   ReminderActivity  — immutable audit trail of all state changes on a reminder
//   Notification      — lightweight in-app notification inbox
//
// Design decisions:
//
//  Reminder vs Notification:
//    A Reminder is action-oriented (needs a response: acknowledge / complete / snooze).
//    A Notification is informational (read / unread). Notifications can optionally
//    link to a Reminder when the notification is "you have a pending action".
//
//  Auto-generated vs manual:
//    isAutoGenerated=true  — created by ReminderGeneratorService in response to
//                            domain events (e.g. interview.scheduled, interview.feedback_submitted)
//    isAutoGenerated=false — manually created by a recruiter via the API
//
//  Workflow links:
//    Reminders carry optional FKs to submission, interview, candidate, job so the
//    Action Center can navigate directly to the relevant workflow entity.
//    All FKs are SetNull on delete so reminders survive entity deletion (as history).
//
//  Snooze:
//    snoozedUntil is set when status transitions to SNOOZED.
//    A scheduled job (future) polls for SNOOZED reminders where snoozedUntil ≤ NOW()
//    and restores them to PENDING. In Phase 1 the API exposes the snooze endpoint
//    and the frontend re-fetches on load (no background wakeup yet).
//
//  Priority auto-escalation:
//    The repository's action-center query promotes overdue reminders to CRITICAL
//    at query time (computed, not stored). This avoids needing a background job
//    to keep priority in sync while still surfacing overdue work prominently.
//
//  Tenant isolation:
//    organizationId is on every table. Every query must scope to organizationId.

// ─── Reminder ─────────────────────────────────────────────────────────────────

model Reminder {
  // ── Identity ──────────────────────────────────────────────────────────────
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid @map("organization_id")

  // ── Classification ────────────────────────────────────────────────────────
  type     ReminderType     // what kind of workflow action this represents
  priority ReminderPriority @default(MEDIUM) // recruiter-visible urgency signal
  status   ReminderStatus   @default(PENDING)

  // ── Content ───────────────────────────────────────────────────────────────
  title       String  @db.VarChar(500)
  description String? @db.Text

  // ── Timing ────────────────────────────────────────────────────────────────
  dueAt        DateTime? @map("due_at")        // when action is due (null = no deadline)
  snoozedUntil DateTime? @map("snoozed_until") // auto-restore to PENDING after this

  // ── State timestamps ──────────────────────────────────────────────────────
  acknowledgedAt DateTime? @map("acknowledged_at")
  completedAt    DateTime? @map("completed_at")
  dismissedAt    DateTime? @map("dismissed_at")

  // ── Origin ────────────────────────────────────────────────────────────────
  // true = created by ReminderGeneratorService; false = created by recruiter
  isAutoGenerated Boolean @default(false) @map("is_auto_generated")

  // ── Workflow links (all optional — SetNull on entity deletion) ────────────
  submissionId String? @db.Uuid @map("submission_id")
  interviewId  String? @db.Uuid @map("interview_id")
  candidateId  String? @db.Uuid @map("candidate_id")
  jobId        String? @db.Uuid @map("job_id")

  // ── Ownership ─────────────────────────────────────────────────────────────
  assigneeId  String @db.Uuid @map("assignee_id")   // recruiter responsible for action
  createdById String @db.Uuid @map("created_by_id") // user or system actor

  // ── Extensibility ─────────────────────────────────────────────────────────
  // Structured extra context for the reminder type:
  //   UPCOMING_INTERVIEW    → { interviewRound, interviewType, scheduledAt }
  //   STALLED_WORKFLOW      → { stalledDays, lastStatusChange }
  //   etc.
  metadata Json @default("{}")

  // ── Audit ─────────────────────────────────────────────────────────────────
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  deletedAt DateTime?                 @map("deleted_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  organization Organization  @relation("OrgReminders", fields: [organizationId], references: [id], onDelete: Restrict)
  assignee     User          @relation("ReminderAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("ReminderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submission   Submission?   @relation("SubmissionReminders", fields: [submissionId], references: [id], onDelete: SetNull)
  interview    Interview?    @relation("InterviewReminders", fields: [interviewId], references: [id], onDelete: SetNull)
  candidate    Candidate?    @relation("CandidateReminders", fields: [candidateId], references: [id], onDelete: SetNull)
  job          JobDescription? @relation("JobReminders", fields: [jobId], references: [id], onDelete: SetNull)

  activities    ReminderActivity[]
  notifications Notification[]

  // ── Indexes ───────────────────────────────────────────────────────────────
  // Primary action-center query: all pending/acknowledged by org, ordered by dueAt
  @@index([organizationId, status, dueAt])
  // Recruiter's personal queue
  @@index([organizationId, assigneeId, status])
  // Type-based filtering (e.g. "show all INTERVIEW_FEEDBACK_PENDING")
  @@index([organizationId, type, status])
  // Workflow navigation: "reminders for this interview"
  @@index([interviewId])
  @@index([submissionId])
  @@index([candidateId])
  // Due-date batch queries for priority escalation
  @@index([dueAt])
  @@index([deletedAt])
  @@map("reminders")
}

// ─── ReminderActivity ─────────────────────────────────────────────────────────
//
// Immutable append-only audit trail. Records every state change, snooze, and
// note added to a reminder. Provides full history for operational review.

model ReminderActivity {
  // ── Identity ──────────────────────────────────────────────────────────────
  id             String                 @id @default(uuid()) @db.Uuid
  reminderId     String                 @db.Uuid @map("reminder_id")
  organizationId String                 @db.Uuid @map("organization_id")
  actorId        String                 @db.Uuid @map("actor_id")

  // ── Event ─────────────────────────────────────────────────────────────────
  action ReminderActivityAction
  note   String?               @db.VarChar(1000) // optional recruiter context
  metadata Json                @default("{}")    // e.g. { snoozedUntil, fromStatus, toStatus }

  // ── Timestamp (no updatedAt — immutable) ──────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  actor    User     @relation("ReminderActivityActor", fields: [actorId], references: [id], onDelete: Restrict)

  // ── Indexes ───────────────────────────────────────────────────────────────
  @@index([reminderId])
  @@index([organizationId, actorId])
  @@map("reminder_activities")
}

// ─── Notification ─────────────────────────────────────────────────────────────
//
// Lightweight in-app inbox entry. Created when a significant workflow event
// occurs and the recipient should be passively informed (vs. a Reminder which
// requires action).
//
// Phase 1: IN_APP channel only. The frontend polls /notifications/unread-count
// to drive the bell badge. Email/SMS delivery is Phase 2.

model Notification {
  // ── Identity ──────────────────────────────────────────────────────────────
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid @map("organization_id")
  recipientId    String @db.Uuid @map("recipient_id")
  reminderId     String? @db.Uuid @map("reminder_id") // optional link to parent reminder

  // ── Channel ───────────────────────────────────────────────────────────────
  channel NotificationChannel @default(IN_APP)
  status  NotificationStatus  @default(PENDING)

  // ── Content ───────────────────────────────────────────────────────────────
  title     String  @db.VarChar(500)
  body      String? @db.Text
  actionUrl String? @db.VarChar(1000) @map("action_url") // deep-link into the platform

  // ── Read state ────────────────────────────────────────────────────────────
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  deliveredAt DateTime? @map("delivered_at")

  // ── Extensibility ─────────────────────────────────────────────────────────
  metadata Json @default("{}")

  // ── Audit ─────────────────────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // ── Relations ─────────────────────────────────────────────────────────────
  organization Organization @relation("OrgNotifications", fields: [organizationId], references: [id], onDelete: Restrict)
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reminder     Reminder?    @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  // ── Indexes ───────────────────────────────────────────────────────────────
  // Bell badge query: count unread for recipient
  @@index([organizationId, recipientId, isRead])
  // Inbox list: most recent first
  @@index([organizationId, recipientId, createdAt])
  @@index([reminderId])
  @@map("notifications")
}
