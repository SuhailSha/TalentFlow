{
  "name": "recruitment-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate --filter=@repo/database",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@repo/database",
    "db:push": "turbo run db:push --filter=@repo/database",
    "db:seed": "turbo run db:seed --filter=@repo/database",
    "db:studio": "turbo run db:studio --filter=@repo/database"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "embedded-postgres": "18.3.0-beta.17",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
