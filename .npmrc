# Strict node_modules structure — prevents phantom dependency bugs
shamefully-hoist=false

# Automatically install peer dependencies (avoids manual peer installs)
auto-install-peers=true

# Fail on peer dependency version mismatches
strict-peer-dependencies=false

# Never update lockfile on install — use pnpm update explicitly
frozen-lockfile=false

# Always resolve packages from the workspace root when possible
prefer-workspace-packages=true
