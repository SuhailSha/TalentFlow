{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": [],
  "references": [
    { "path": "./apps/api" },
    { "path": "./apps/web" },
    { "path": "./packages/config" },
    { "path": "./packages/database" },
    { "path": "./packages/types" },
    { "path": "./packages/validators" }
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
